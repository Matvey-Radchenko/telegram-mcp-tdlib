#!/bin/zsh
set -eu

credentials_dir="${HOME}/.config/telegram-mcp"
api_id_file="$credentials_dir/api-id"
api_hash_file="$credentials_dir/api-hash"
default_java_home="${HOME}/.local/opt/jdks/temurin-25.0.4.1/Contents/Home"
java_home="${TELEGRAM_MCP_JAVA_HOME:-$default_java_home}"
jar_path="${HOME}/.local/opt/telegram-mcp-codex/current/telegram-mcp-server.jar"
tdlib_log="${HOME}/Library/Application Support/TelegramMcpServer/tdlib/default/td.binlog"

if [[ ! -s "$api_id_file" || ! -s "$api_hash_file" ]]; then
  print -u2 "Telegram MCP credentials are missing. Run scripts/local/save-credentials.sh from the recovery repository."
  exit 1
fi
if [[ ! -x "$java_home/bin/java" ]]; then
  print -u2 "Telegram MCP Java runtime is missing at $java_home."
  exit 1
fi
if [[ ! -f "$jar_path" ]]; then
  print -u2 "Managed Telegram MCP JAR is missing at $jar_path."
  exit 1
fi

if [[ "${1:-}" == "serve" ]]; then
  if [[ " $* " == *" --transport stdio "* ]]; then
    print -u2 "STDIO is disabled for the shared TDLib session. Use the singleton HTTP daemon on 127.0.0.1:8765."
    exit 2
  fi

  if [[ -e "$tdlib_log" ]] && command -v lsof >/dev/null 2>&1; then
    existing_owners="$(lsof -t -- "$tdlib_log" 2>/dev/null | sort -u | tr '\n' ' ')"
    if [[ -n "$existing_owners" ]]; then
      print -u2 "TDLib session is already owned by process(es): $existing_owners"
      exit 2
    fi
  fi
fi

export TDLIB_API_ID="$(< "$api_id_file")"
export TDLIB_API_HASH_FILE="$api_hash_file"

exec "$java_home/bin/java" --enable-native-access=ALL-UNNAMED -jar "$jar_path" "$@"
